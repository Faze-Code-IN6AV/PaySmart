            },
            "url": { "raw": "{{auth_url}}/auth/admin/create-client", "host": ["{{auth_url}}"], "path": ["auth", "admin", "create-client"] }
          }
        },
        {
          "name": "Admin — Listar clientes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{auth_url}}/users/clients", "host": ["{{auth_url}}"], "path": ["users", "clients"] }
          }
