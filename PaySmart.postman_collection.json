{
  "info": {
    "name": "PaySmart API",
    "description": "Colección completa de endpoints para el sistema de pagos PaySmart. Incluye AuthService, AccountService, TransactionService, ProductService, FavoriteAccountService y ReportService.\n\n**Instrucciones:**\n1. Importa este archivo en Postman.\n2. Configura la variable `token` pegando el JWT que devuelve el endpoint de Login.\n3. Ejecuta los requests en el orden sugerido dentro de cada carpeta.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "auth_url",        "value": "http://localhost:3000/api/v1",         "type": "string" },
    { "key": "account_url",     "value": "http://localhost:3001/paySmart/v1",    "type": "string" },
    { "key": "transaction_url", "value": "http://localhost:3002/paySmart/v1",    "type": "string" },
    { "key": "product_url",     "value": "http://localhost:3003/paySmart/v1",    "type": "string" },
    { "key": "favorite_url",    "value": "http://localhost:3004/paySmart/v1",    "type": "string" },
    { "key": "report_url",      "value": "http://localhost:3005/paySmart/v1",    "type": "string" },
    { "key": "token",           "value": "PEGA_TU_JWT_AQUI",                     "type": "string" },
    { "key": "account_number",  "value": "123456789012345678",                   "type": "string" },
    { "key": "user_id",         "value": "",                                     "type": "string" },
    { "key": "product_id",      "value": "",                                     "type": "string" },
    { "key": "transaction_id",  "value": "",                                     "type": "string" },
    { "key": "favorite_id",     "value": "",                                     "type": "string" }
  ],
  "item": [
    {
      "name": "AuthService",
      "description": "Autenticación, registro y gestión de usuarios. Base URL: http://localhost:3000/api/v1",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{auth_url}}/health", "host": ["{{auth_url}}"], "path": ["health"] }
          }
        },
        {
          "name": "Registro de usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan\",\n  \"surname\": \"Pérez\",\n  \"username\": \"juanperez\",\n  \"email\": \"juan@ejemplo.com\",\n  \"password\": \"Password123!\",\n  \"phone\": \"55551234\",\n  \"dpi\": \"1234567890123\",\n  \"address\": \"Zona 1, Ciudad de Guatemala\",\n  \"workName\": \"Empresa S.A.\",\n  \"monthlyIncome\": 5000\n}"
            },
            "url": { "raw": "{{auth_url}}/auth/register", "host": ["{{auth_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Verificar email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"TOKEN_DEL_EMAIL\"\n}"
            },
            "url": { "raw": "{{auth_url}}/auth/verify-email", "host": ["{{auth_url}}"], "path": ["auth", "verify-email"] }
          }
        },
        {
          "name": "Reenviar verificación",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@ejemplo.com\"\n}"
            },
            "url": { "raw": "{{auth_url}}/auth/resend-verification", "host": ["{{auth_url}}"], "path": ["auth", "resend-verification"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "  console.log('Token guardado automáticamente.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailOrUsername\": \"juanperez\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{auth_url}}/auth/login", "host": ["{{auth_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Recuperar contraseña",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@ejemplo.com\"\n}"
            },
            "url": { "raw": "{{auth_url}}/auth/forgot-password", "host": ["{{auth_url}}"], "path": ["auth", "forgot-password"] }
          }
        },
        {
          "name": "Resetear contraseña",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"TOKEN_DEL_EMAIL\",\n  \"newPassword\": \"NuevaPassword123!\"\n}"
            },
            "url": { "raw": "{{auth_url}}/auth/reset-password", "host": ["{{auth_url}}"], "path": ["auth", "reset-password"] }
          }
        },
        {
          "name": "Ver mi perfil",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{auth_url}}/auth/profile", "host": ["{{auth_url}}"], "path": ["auth", "profile"] }
          }
        },
        {
          "name": "Editar mi perfil",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan Actualizado\",\n  \"surname\": \"Pérez\",\n  \"address\": \"Zona 10, Ciudad de Guatemala\",\n  \"workName\": \"Nueva Empresa S.A.\",\n  \"monthlyIncome\": 7500\n}"
            },
            "url": { "raw": "{{auth_url}}/auth/profile", "host": ["{{auth_url}}"], "path": ["auth", "profile"] }
          }
        },
        {
