            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"María Editada\",\n  \"address\": \"Zona 15, Ciudad de Guatemala\",\n  \"workName\": \"Farmacia Central\",\n  \"monthlyIncome\": 15000\n}"
            },
            "url": { "raw": "{{auth_url}}/users/clients/{{user_id}}", "host": ["{{auth_url}}"], "path": ["users", "clients", "{{user_id}}"] }
          }
        },
        {
          "name": "Admin — Eliminar cliente",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{auth_url}}/users/clients/{{user_id}}", "host": ["{{auth_url}}"], "path": ["users", "clients", "{{user_id}}"] }
          }
